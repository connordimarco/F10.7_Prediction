#PBS -N f107_cells
#PBS -l select=1:ncpus=512:model=tur_ath
#PBS -l walltime=02:00:00
#PBS -q normal
#PBS -W group_list=s3007
#PBS -j oe
#PBS -o /nobackupp28/cdimarco/F10.7_Prediction/experiments/horizon_matrix/logs/
#PBS -m be
#PBS -M cdimarco@umich.edu
# Whole-cell fan-out on one node: CELLS="F107_E40_nn F107_E41_mlp ..." run
# up to 8 cells concurrently. Thread pins: LightGBM cells read n_jobs from
# single_model.CFG44 (override with LGBM_THREADS), torch cells from
# TORCH_THREADS. Submit from horizon_matrix:
#   qsub -v CELLS="F107_E40_nn F107_E41_mlp",TORCH_THREADS=64 shared/run_cells.pbs
set -u
cd /nobackupp28/cdimarco/F10.7_Prediction/experiments/horizon_matrix
export LGBM_THREADS=${LGBM_THREADS:-64} TORCH_THREADS=${TORCH_THREADS:-64} OMP_NUM_THREADS=${TORCH_THREADS:-64}
echo "$CELLS" | tr ' ' '\n' | xargs -P 8 -I{} sh -c \
    'rm -f {}/out/scorecard.json; shared/run_local.sh {} > logs/{}.log 2>&1 || echo "cell {} FAILED"'
../../env/bin/python shared/leaderboard.py
echo "cells [$CELLS] done $(date)"
