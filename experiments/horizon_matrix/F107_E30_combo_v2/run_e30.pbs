#PBS -N f107_e30
#PBS -l select=1:ncpus=512:model=tur_ath
#PBS -l walltime=03:00:00
#PBS -q normal
#PBS -W group_list=s3007
#PBS -j oe
#PBS -o /nobackupp28/cdimarco/F10.7_Prediction/experiments/horizon_matrix/logs/
#PBS -m be
#PBS -M cdimarco@umich.edu
# E30 lead fan-out: LEADS="a b c ..." run 8 concurrent x 32 threads
# (n_jobs pinned inside e30_lead.py). Submit from horizon_matrix:
#   qsub -v LEADS="1 2 3 4 5 6 7 8" -N e30a F107_E30_combo_v2/run_e30.pbs
set -u
cd /nobackupp28/cdimarco/F10.7_Prediction/experiments/horizon_matrix
mkdir -p F107_E30_combo_v2/out
echo "$LEADS" | tr ' ' '\n' | xargs -P 8 -I{} sh -c \
    '../../env/bin/python F107_E30_combo_v2/e30_lead.py {} > F107_E30_combo_v2/out/run_{}.log 2>&1 || echo "lead {} FAILED"'
echo "E30 leads [$LEADS] done $(date)"
